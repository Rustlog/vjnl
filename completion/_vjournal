#compdef vjournal

# vim: sts=4 sw=4 ft=zsh:

function _vjournal() {
    local prev cur opts global_opts_long section_opts_long section_opts_short section_opts_list
    local spls_dir log_dir template_dir spls_files
    local -i found_action=0

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    journal_directory="${VJOURNAL_DIR:-$HOME/dev/journals}"
    spls_dir="${journal_directory}/spls"
    log_dir="${journal_directory}/logs"
    template_dir="${journal_directory}/data/templates"

    spls_files="$(find "${spls_dir}" \
        -mindepth 1 -maxdepth 1 -type f -printf ' %f ' 2>/dev/null)"
    log_files="$(find "${log_dir}" \
        -mindepth 1 -maxdepth 1 -type f -printf ' %f ' 2>/dev/null)"
    template_files="$(find "${template_dir}" \
        -mindepth 1 -maxdepth 1 -type f -printf ' %f ' 2>/dev/null)"
    all_files="$(find "${spls_dir}" "${log_dir}" "${template_dir}" \
        -mindepth 1 -maxdepth 1 -type f -printf ' %f ' 2>/dev/null)"
    template_files+=" default"

    global_opts_long="--loglevel --verbose --no-pager \
            --color --no-color --version --author \
            --tree-view --license --repo --about --help --full-help"

    section_opts_long="--journal --log --template --use"
    section_opts_short="-j -l -t -u"
    section_opts_list_name="journals templates logs"
    use_options="default blank"

    opts="edit-journal edit-template edit-log \
        show-journal show-template show-log \
        cat-journal cat-template cat-log \
        delete-journal delete-template \
        copy-journal copy-template copy-log \
        move-journal move-template move-log \
        edit show cat list delete rename copy"

    # [[ "$COMP_CWORD" -ge 1 ]] || return 1

    for cmd in "${COMP_WORDS[@]}"; do
        for action in ${opts}; do
            [[ "${cmd}" =~ ^"${action}"$ ]] && found_action=1
        done
    done

    if [[ "$found_action" -ne 1 || "$cur" =~ ^(cat|copy|rename|show|edit)$ ]]; then
        if [[ "$cur" == -* ]]; then
            COMPREPLY=($(compgen -W "${global_opts_long}" -- "${cur}"))
        else
            COMPREPLY=($(compgen -W "${opts}" -- "${cur}"))
        fi
        return 0
    fi

    if [[ "$cur" == --* ]]; then
        COMPREPLY=($(compgen -W "${section_opts_long}" -- "${cur}"))
    elif [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "${section_opts_short}" -- "${cur}"))
    elif [[ "$prev" == list ]]; then
        COMPREPLY=($(compgen -W "${section_opts_list_name}" -- "${cur}"))
    elif [[ "$prev" != vjournal && "$prev" == *journal ]]; then
        COMPREPLY=($(compgen -W "${spls_files}" -- "${cur}"))
    elif [[ "$prev" == *template ]]; then
        COMPREPLY=($(compgen -W "${template_files}" -- "${cur}"))
    elif [[ "$prev" == *log ]]; then
        COMPREPLY=($(compgen -W "${log_files}" -- "${cur}"))
    else
        if [[ "$prev" =~ ^("-j|--journal")$ ]]; then
            COMPREPLY=($(compgen -W "${spls_files}" -- "${cur}"))
        elif [[ "$prev" =~ ^("-t|--template")$ ]]; then
            COMPREPLY=($(compgen -W "${template_files}" -- "${cur}"))
        elif [[ "$prev" =~ ^("-l|--log")$ ]]; then
            COMPREPLY=($(compgen -W "${log_files}" -- "${cur}"))
        elif [[ "$prev" =~ ^("-u|--use")$ ]]; then
            COMPREPLY=($(compgen -W "${use_options}" -- "${cur}"))
        else
            COMPREPLY=($(compgen -W "${all_files}" -- "${cur}"))
        fi
    fi
}

complete -F _vjournal vjournal

